    },
    "RealWorldQA": {
      "class": "ImageMCQDataset",
      "dataset": "RealWorldQA"
    },
    "VisOnlyQA-VLMEvalKit": {
      "class": "ImageMCQDataset",
      "dataset": "VisOnlyQA-VLMEvalKit"
    },
    "HallusionBench": {
      "class": "ImageYORNDataset",
      "dataset": "HallusionBench"
    },
    "POPE": {
      "class": "ImageYORNDataset",
      "dataset": "POPE"
